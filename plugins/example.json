{
    "id": "example-image-plugin",
    "name": "Image Processor with Conditional UI",
    "description": "Processes images with optional advanced parameters. Advanced options are shown only when enabled.",
    "version": "1.1",
    "inputs": [
        {
            "id": "inputFolder",
            "name": "Input Folder",
            "type": "Folder",
            "description": "Folder containing the source images.",
            "ui": {
                "control": "folderPicker"
            }
        },
        {
            "id": "toggleProcessing",
            "name": "Enable Advanced Processing",
            "type": "boolean",
            "default": false,
            "description": "Toggle to enable or disable advanced processing options.",
            "ui": {
                "control": "checkbox"
            }
        },
        {
            "id": "advancedParameter",
            "name": "Advanced Parameter",
            "type": "number",
            "default": 0.5,
            "description": "An advanced processing parameter (only visible if advanced processing is enabled).",
            "ui": {
                "control": "slider",
                "min": 0,
                "max": 1,
                "step": 0.05,
                "visibleWhen": "toggleProcessing === true"
            }
        },
        {
            "id": "threshold",
            "name": "Threshold",
            "type": "number",
            "default": 128,
            "description": "Threshold value for image processing.",
            "ui": {
                "control": "slider",
                "min": 0,
                "max": 255,
                "step": 1
            }
        }
    ],
    "outputs": [
        {
            "id": "processedFolder",
            "name": "Processed Images",
            "type": "Folder",
            "description": "Folder where processed images will be stored."
        },
        {
            "id": "logsFolder",
            "name": "Logs",
            "type": "Folder",
            "description": "Folder containing processing logs and reports."
        }
    ],
    "command": "docker run --rm image_processing_plugin:latest --input {inputFolder} --threshold {threshold} --advanced {advancedParameter} --output {processedFolder} --logs {logsFolder}"
}