{
  "name": "lite",
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "nodemon --quiet --watch main.js --watch preload.cjs --watch renderer --ext js,html,css --exec \"electron --no-focus .\"",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.lite.app",
    "productName": "Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "publish": null,
    "icon": "icons/favicon-256x256.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/favicon-256x256.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/favicon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/favicon-256x256.png"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "litegraph.js": "^0.7.18"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.9"
  }
}