{
  "name": "lite",
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "nodemon --quiet --watch main.js --watch preload.cjs --watch renderer --ext js,html,css --exec \"electron --no-focus .\"",
    "build": "node scripts/package.js",
    "build:mac": "node scripts/package.js --mac",
    "build:win": "node scripts/package.js --win",
    "build:linux": "node scripts/package.js --linux",
    "build:all": "node scripts/package.js --mac --win --linux",
    "pack": "electron-builder --dir",
    "pack:mac": "electron-builder --mac --dir",
    "pack:win": "electron-builder --win --dir",
    "pack:linux": "electron-builder --linux --dir",
    "clean": "rm -rf dist",
    "package": "npm run clean && npm run build"
  },
  "build": {
    "appId": "com.lite.app",
    "productName": "Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**/*",
      "handlers/**/*",
      "plugins/**/*",
      "nodes/**/*",
      "icons/**/*",
      "node_modules/**/*"
    ],
    "publish": null,
    "icon": "build/icon-512.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon-512.png"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "litegraph.js": "^0.7.18"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.9"
  }
}